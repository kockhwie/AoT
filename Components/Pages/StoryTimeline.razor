@page "/story"
@page "/timeline"
@page "/{Lang}/story"
@page "/{Lang}/timeline"
@using AOT.Services
@implements IDisposable
@inject AppLocalizationService LocalizationService
@inject LanguageSwitchService LanguageSwitcher
@inject NavigationManager Nav

<PageTitle>@(IsStoryTab ? LocalizationService.GetString("StoryTabTitle") : LocalizationService.GetString("TimelineTabTitle")) - @LocalizationService.GetString("PageTitle")</PageTitle>

<div class="aot-page-container">
    <!-- Premium Obsidian Header Panel -->
    <div class="aot-story-header">
        <h1 class="aot-page-title uppercase">@LocalizationService.GetString("StoryPageHeader")</h1>
        <p class="aot-page-subtitle font-sans">@LocalizationService.GetString("StoryPageSub")</p>
        
        <!-- Toggle Switch Tab Container -->
        <div class="aot-tab-switcher">
            <button class="aot-tab-btn aot-btn @(IsStoryTab ? "active" : "") font-sans" @onclick='() => SwitchTab("story")'>
                <i class="ti ti-books"></i> @LocalizationService.GetString("StoryTabTitle")
            </button>
            <button class="aot-tab-btn aot-btn @(!IsStoryTab ? "active" : "") font-sans" @onclick='() => SwitchTab("timeline")'>
                <i class="ti ti-clock"></i> @LocalizationService.GetString("TimelineTabTitle")
            </button>
        </div>
    </div>

    <!-- Active View Area -->
    <div class="aot-view-content mt-6">
        @if (IsStoryTab)
        {
            <!-- Story Arcs View -->
            <div class="aot-story-grid">
                @foreach (var arc in _storyArcs)
                {
                    <div class="aot-arc-card comic-card">
                        <div class="aot-arc-card-face">
                            <div class="aot-arc-header">
                                <span class="aot-arc-vol font-sans">@LocalizationService.GetString(arc.ChaptersKey)</span>
                                <h2 class="aot-arc-title font-sans">@LocalizationService.GetString(arc.TitleKey)</h2>
                            </div>
                            <p class="aot-arc-desc font-sans">@LocalizationService.GetString(arc.DescKey)</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Chronological Timeline View -->
            <div class="aot-timeline-container">
                <ul class="timeline timeline-vertical timeline-compact">
                    @for (int i = 0; i < _timelineEvents.Count; i++)
                    {
                        var evt = _timelineEvents[i];
                        <li>
                            @if (i > 0)
                            {
                                <hr class="timeline-connector" />
                            }
                            <div class="timeline-middle timeline-icon @evt.IconColorClass">
                                <i class="ti @evt.IconClass"></i>
                            </div>
                            <div class="timeline-end aot-timeline-box">
                                <time class="aot-timeline-time font-sans">@LocalizationService.GetString(evt.YearKey) @(LocalizationService.ActiveLang == "en" ? "" : "年")</time>
                                <div class="aot-timeline-title font-sans">@LocalizationService.GetString(evt.TitleKey)</div>
                                <p class="aot-timeline-desc font-sans">@LocalizationService.GetString(evt.DescKey)</p>
                            </div>
                            @if (i < _timelineEvents.Count - 1)
                            {
                                <hr class="timeline-connector" />
                            }
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Lang { get; set; }

    private bool IsStoryTab => Nav.Uri.EndsWith("/story", StringComparison.OrdinalIgnoreCase) || Nav.Uri.Contains("/story?", StringComparison.OrdinalIgnoreCase);

    private sealed class StoryArcModel
    {
        public string TitleKey { get; init; } = "";
        public string ChaptersKey { get; init; } = "";
        public string DescKey { get; init; } = "";
    }

    private readonly List<StoryArcModel> _storyArcs = new()
    {
        new StoryArcModel { TitleKey = "Arc1Title", ChaptersKey = "Arc1Chapters", DescKey = "Arc1Desc" },
        new StoryArcModel { TitleKey = "Arc2Title", ChaptersKey = "Arc2Chapters", DescKey = "Arc2Desc" },
        new StoryArcModel { TitleKey = "Arc3Title", ChaptersKey = "Arc3Chapters", DescKey = "Arc3Desc" },
        new StoryArcModel { TitleKey = "Arc4Title", ChaptersKey = "Arc4Chapters", DescKey = "Arc4Desc" },
        new StoryArcModel { TitleKey = "Arc5Title", ChaptersKey = "Arc5Chapters", DescKey = "Arc5Desc" },
        new StoryArcModel { TitleKey = "Arc6Title", ChaptersKey = "Arc6Chapters", DescKey = "Arc6Desc" },
        new StoryArcModel { TitleKey = "Arc7Title", ChaptersKey = "Arc7Chapters", DescKey = "Arc7Desc" },
        new StoryArcModel { TitleKey = "Arc8Title", ChaptersKey = "Arc8Chapters", DescKey = "Arc8Desc" },
        new StoryArcModel { TitleKey = "Arc9Title", ChaptersKey = "Arc9Chapters", DescKey = "Arc9Desc" },
        new StoryArcModel { TitleKey = "Arc10Title", ChaptersKey = "Arc10Chapters", DescKey = "Arc10Desc" }
    };

    private sealed class TimelineEventModel
    {
        public int Id { get; init; }
        public string TitleKey => $"Timeline_Event{Id}_Title";
        public string DescKey => $"Timeline_Event{Id}_Desc";
        public string YearKey => $"Timeline_Event{Id}_Year";
        public string IconClass { get; init; } = "ti-clock";
        public string IconColorClass { get; init; } = "timeline-icon--battle";
    }

    private readonly List<TimelineEventModel> _timelineEvents = new()
    {
        new TimelineEventModel { Id = 1, IconClass = "ti-sparkles", IconColorClass = "timeline-icon--catastrophe" },
        new TimelineEventModel { Id = 2, IconClass = "ti-skull", IconColorClass = "timeline-icon--catastrophe" },
        new TimelineEventModel { Id = 3, IconClass = "ti-swords", IconColorClass = "timeline-icon--battle" },
        new TimelineEventModel { Id = 4, IconClass = "ti-wall", IconColorClass = "timeline-icon--recon" },
        new TimelineEventModel { Id = 5, IconClass = "ti-key", IconColorClass = "timeline-icon--betrayal" },
        new TimelineEventModel { Id = 6, IconClass = "ti-skull", IconColorClass = "timeline-icon--catastrophe" },
        new TimelineEventModel { Id = 7, IconClass = "ti-flame", IconColorClass = "timeline-icon--catastrophe" },
        new TimelineEventModel { Id = 8, IconClass = "ti-vaccine", IconColorClass = "timeline-icon--recon" },
        new TimelineEventModel { Id = 9, IconClass = "ti-alert-triangle", IconColorClass = "timeline-icon--catastrophe" },
        new TimelineEventModel { Id = 10, IconClass = "ti-shield-check", IconColorClass = "timeline-icon--battle" },
        new TimelineEventModel { Id = 11, IconClass = "ti-horse", IconColorClass = "timeline-icon--recon" },
        new TimelineEventModel { Id = 12, IconClass = "ti-diamond", IconColorClass = "timeline-icon--battle" },
        new TimelineEventModel { Id = 13, IconClass = "ti-users", IconColorClass = "timeline-icon--betrayal" },
        new TimelineEventModel { Id = 14, IconClass = "ti-sword", IconColorClass = "timeline-icon--battle" },
        new TimelineEventModel { Id = 15, IconClass = "ti-building-monument", IconColorClass = "timeline-icon--betrayal" },
        new TimelineEventModel { Id = 16, IconClass = "ti-crosshair", IconColorClass = "timeline-icon--battle" },
        new TimelineEventModel { Id = 17, IconClass = "ti-flag", IconColorClass = "timeline-icon--war" },
        new TimelineEventModel { Id = 18, IconClass = "ti-cloud-computing", IconColorClass = "timeline-icon--rumbling" },
        new TimelineEventModel { Id = 19, IconClass = "ti-crown", IconColorClass = "timeline-icon--final" }
    };

    protected override void OnInitialized()
    {
        LanguageSwitcher.OnLanguageChanged += HandleLanguageChanged;
        Nav.LocationChanged += HandleLocationChanged;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Lang))
        {
            LanguageSwitcher.Initialize(Lang);
            LocalizationService.ActiveLang = LanguageSwitcher.ActiveLang;
        }
    }

    private void HandleLanguageChanged(string newLanguage)
    {
        StateHasChanged();
    }

    private void SwitchTab(string tab)
    {
        // avoid navigating to the same tab (prevents no-op navigation that doesn't trigger
        // state change in some cases)
        if ((tab == "story" && IsStoryTab) || (tab == "timeline" && !IsStoryTab))
            return;

        var prefix = LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang);
        Nav.NavigateTo($"{prefix}/{tab}", forceLoad: false);
    }

    public void Dispose()
    {
        LanguageSwitcher.OnLanguageChanged -= HandleLanguageChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // ensure component re-renders when the URL changes so IsStoryTab updates
        InvokeAsync(StateHasChanged);
    }
}
