        new() { Id = 37, Type = EvtType.Revelation, Significance = 10, MangaRef = "Vol. 30" },
        new() { Id = 38, Type = EvtType.Endgame,    Significance = 10, MangaRef = "Vol. 31" },
        new() { Id = 39, Type = EvtType.Massacre,   Significance = 10, MangaRef = "Vol. 32\u201333" },
        new() { Id = 40, Type = EvtType.Political,  Significance = 8,  MangaRef = "Vol. 32" },
        new() { Id = 41, Type = EvtType.Battle,     Significance = 9,  MangaRef = "Vol. 33\u201334" },
        new() { Id = 42, Type = EvtType.Endgame,    Significance = 9,  MangaRef = "Vol. 34" },
        new() { Id = 43, Type = EvtType.Endgame,    Significance = 10, MangaRef = "Vol. 34" },
        new() { Id = 44, Type = EvtType.Endgame,    Significance = 10, MangaRef = "Vol. 34" },
        new() { Id = 45, Type = EvtType.Political,  Significance = 6,  MangaRef = "Vol. 34" },
        new() { Id = 46, Type = EvtType.Political,  Significance = 5,  MangaRef = "Vol. 34, extra pages" },
        new() { Id = 47, Type = EvtType.Endgame,    Significance = 7,  MangaRef = "Vol. 34, extra pages" },
        new() { Id = 48, Type = EvtType.Revelation, Significance = 6,  MangaRef = "Vol. 34, extra pages" },
    };

    // ── Era grouping — a header renders above the first event whose Id matches a boundary ──
    private sealed record EraGroup(string TitleKey, List<TimelineEventModel> Events);

    private static readonly (int StartId, string TitleKey)[] _eraBoundaries =
    {
        (1, "Era_Ancient"),
        (5, "Era_Prelude"),
        (10, "Era_TrostFemale"),
        (19, "Era_Uprising"),
        (21, "Era_ReturnShiganshina"),
        (31, "Era_Marley"),
        (38, "Era_Rumbling"),
        (45, "Era_Epilogue"),
    };

    private List<EraGroup> EraGroups
    {
        get
        {
            var groups = new List<EraGroup>();
            for (int i = 0; i < _eraBoundaries.Length; i++)
            {
                var (startId, titleKey) = _eraBoundaries[i];
                var endId = i + 1 < _eraBoundaries.Length ? _eraBoundaries[i + 1].StartId - 1 : int.MaxValue;
                var events = _timelineEvents.Where(e => e.Id >= startId && e.Id <= endId).ToList();
                groups.Add(new EraGroup(titleKey, events));
            }
            return groups;
        }
    }

    private static string IconClass(EvtType t) => t switch
    {
        EvtType.WallBreach => "ti-wall",
        EvtType.Battle => "ti-sword",
        EvtType.Political => "ti-flag",
        EvtType.Revelation => "ti-eye",
        EvtType.Massacre => "ti-skull",
        EvtType.CovertOp => "ti-spy",
        EvtType.Endgame => "ti-crown",
        _ => "ti-clock"
    };

    private static string IconColorClass(EvtType t) => t switch
    {
        EvtType.WallBreach => "timeline-icon--catastrophe",
        EvtType.Massacre => "timeline-icon--catastrophe",
        EvtType.Battle => "timeline-icon--battle",
        EvtType.Political => "timeline-icon--betrayal",
        EvtType.Revelation => "timeline-icon--recon",
        EvtType.CovertOp => "timeline-icon--war",
        EvtType.Endgame => "timeline-icon--final",
        _ => "timeline-icon--battle"
    };

    private static string TypeLabelKey(EvtType t) => $"EvtType_{t}";

    private static string SigBadgeClass(int significance) => significance switch
    {
        10 => "comic-badge--gold",
        >= 8 => "comic-badge--accent",
        _ => "comic-badge--silver"
    };

    // manga refs look like "Vol. 22, Ch. 89" or "Vol. 22" — pull the first volume number so we
    // can deep-link into the Manga section; falls back to plain text if it doesn't resolve.
    private static int? ParseVolume(string mangaRef)
    {
        var m = System.Text.RegularExpressions.Regex.Match(mangaRef, @"Vol\.\s*(\d+)");
        return m.Success && int.TryParse(m.Groups[1].Value, out var v) ? v : null;
    }

    // Only append the localized "年" suffix to genuinely numeric years — "Far Future" /
    // "Post-857" etc. are already fully localized text and shouldn't get it glued on.
    private static bool IsNumericYear(string year) =>
        System.Text.RegularExpressions.Regex.IsMatch(year, @"^[~0-9\sB\-\u2013]+$");

    private string YearDisplay(TimelineEventModel evt)
    {
        var y = LocalizationService.GetString(evt.YearKey);
        var suffix = LocalizationService.ActiveLang != "en" && IsNumericYear(y) ? "\u5e74" : "";
        return y + suffix;
    }

    // ── Curse of Ymir panel data ──
    private sealed record CurseFact(string LabelKey, string ValueKey);

    private readonly List<CurseFact> _curseFacts = new()
    {
        new("Curse_CountdownLabel", "Curse_CountdownValue"),
        new("Curse_NoResetLabel", "Curse_NoResetValue"),
        new("Curse_UniversalLabel", "Curse_UniversalValue"),
        new("Curse_DeteriorationLabel", "Curse_DeteriorationValue"),
        new("Curse_NoExceptionsLabel", "Curse_NoExceptionsValue"),
    };

    private sealed record CurseExample(string NameKey, string Inherited, string Died, string NoteKey);

    private readonly List<CurseExample> _curseExamples = new()
    {
        new("Curse_Ex1_Name", "~1003 B1", "~990 B1", "Curse_Ex1_Note"),
        new("Curse_Ex2_Name", "832", "845", "Curse_Ex2_Note"),
        new("Curse_Ex3_Name", "~819", "832", "Curse_Ex3_Note"),
        new("Curse_Ex4_Name", "~829", "842", "Curse_Ex4_Note"),
        new("Curse_Ex5_Name", "842", "845", "Curse_Ex5_Note"),
        new("Curse_Ex6_Name", "845", "854", "Curse_Ex6_Note"),
    };

    protected override void OnInitialized()
    {
        LanguageSwitcher.OnLanguageChanged += HandleLanguageChanged;
        Nav.LocationChanged += HandleLocationChanged;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Lang))
        {
            LanguageSwitcher.Initialize(Lang);
            LocalizationService.ActiveLang = LanguageSwitcher.ActiveLang;
        }
    }

    private void HandleLanguageChanged(string newLanguage)
    {
        StateHasChanged();
    }

    private void SwitchTab(string tab)
    {
        // avoid navigating to the same tab (prevents no-op navigation that doesn't trigger
        // state change in some cases)
        if ((tab == "story" && IsStoryTab) || (tab == "timeline" && !IsStoryTab))
            return;

        var prefix = LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang);
        Nav.NavigateTo($"{prefix}/{tab}", forceLoad: false);
    }

    public void Dispose()
    {
        LanguageSwitcher.OnLanguageChanged -= HandleLanguageChanged;
        Nav.LocationChanged -= HandleLocationChanged;
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        // ensure component re-renders when the URL changes so IsStoryTab updates
        InvokeAsync(StateHasChanged);
    }
}
