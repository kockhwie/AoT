    // ── Timeline event type — drives icon glyph, icon color, and the type badge label ──
    private enum EvtType { WallBreach, Battle, Political, Revelation, Massacre, CovertOp, Endgame }

    private sealed class TimelineEventModel
    {
        public int Id { get; init; }
        public string TitleKey => $"Timeline_Event{Id}_Title";
        public string DescKey => $"Timeline_Event{Id}_Desc";
        public string YearKey => $"Timeline_Event{Id}_Year";
        public EvtType Type { get; init; }
        public int Significance { get; init; } // 1-10, from the research doc
        public string MangaRef { get; init; } = ""; // plain text, e.g. "Vol. 22, Ch. 89" — language neutral
    }

    // Full chronology, ancient history through the epilogue. Type/Significance/MangaRef are
    // language-neutral so they live here as plain data rather than resx keys — only
    // Title/Desc/Year need translation (see Timeline_Event{Id}_* resx keys).
    private readonly List<TimelineEventModel> _timelineEvents = new()
    {
        new() { Id = 1,  Type = EvtType.Revelation, Significance = 10, MangaRef = "Vol. 30, Ch. 122" },
        new() { Id = 2,  Type = EvtType.Revelation, Significance = 10, MangaRef = "Vol. 30, Ch. 122" },
        new() { Id = 3,  Type = EvtType.Political,  Significance = 9,  MangaRef = "Vol. 22, Ch. 89" },
        new() { Id = 4,  Type = EvtType.Political,  Significance = 10, MangaRef = "Vol. 22, Ch. 89" },
        new() { Id = 5,  Type = EvtType.CovertOp,   Significance = 9,  MangaRef = "Vol. 22, Ch. 87\u201388" },
        new() { Id = 6,  Type = EvtType.Massacre,   Significance = 7,  MangaRef = "Vol. 2, Ch. 6" },
        new() { Id = 7,  Type = EvtType.WallBreach, Significance = 10, MangaRef = "Vol. 1, Ch. 1\u20132" },
        new() { Id = 8,  Type = EvtType.CovertOp,   Significance = 10, MangaRef = "Vol. 15, Ch. 62\u201363" },
        new() { Id = 9,  Type = EvtType.Battle,     Significance = 8,  MangaRef = "Vol. 1, Ch. 3" },
        new() { Id = 10, Type = EvtType.Battle,     Significance = 9,  MangaRef = "Vol. 3\u20134" },
        new() { Id = 11, Type = EvtType.Battle,     Significance = 8,  MangaRef = "Vol. 5\u20137" },
        new() { Id = 12, Type = EvtType.Battle,     Significance = 9,  MangaRef = "Vol. 8, Ch. 31\u201334" },
        new() { Id = 13, Type = EvtType.Revelation, Significance = 9,  MangaRef = "Vol. 9\u201310" },
        new() { Id = 14, Type = EvtType.CovertOp,   Significance = 9,  MangaRef = "Vol. 11, Ch. 42\u201344" },
        new() { Id = 15, Type = EvtType.Battle,     Significance = 8,  MangaRef = "Vol. 11\u201312, Ch. 44\u201349" },
        new() { Id = 16, Type = EvtType.Massacre,   Significance = 8,  MangaRef = "Vol. 12, Ch. 49\u201350" },
        new() { Id = 17, Type = EvtType.Revelation, Significance = 10, MangaRef = "Vol. 12, Ch. 50" },
        new() { Id = 18, Type = EvtType.Political,  Significance = 9,  MangaRef = "Vol. 12, Ch. 50" },
        new() { Id = 19, Type = EvtType.Political,  Significance = 9,  MangaRef = "Vol. 13\u201317" },
        new() { Id = 20, Type = EvtType.Political,  Significance = 8,  MangaRef = "Vol. 17" },
        new() { Id = 21, Type = EvtType.Political,  Significance = 8,  MangaRef = "Vol. 18, Ch. 70\u201372" },
        new() { Id = 22, Type = EvtType.CovertOp,   Significance = 8,  MangaRef = "Vol. 18, Ch. 73\u201374" },
        new() { Id = 23, Type = EvtType.Battle,     Significance = 10, MangaRef = "Vol. 18\u201319, Ch. 74\u201377" },
        new() { Id = 24, Type = EvtType.Battle,     Significance = 9,  MangaRef = "Vol. 19, Ch. 77\u201379" },
        new() { Id = 25, Type = EvtType.Battle,     Significance = 10, MangaRef = "Vol. 20, Ch. 80" },
        new() { Id = 26, Type = EvtType.Battle,     Significance = 10, MangaRef = "Vol. 20, Ch. 81" },
        new() { Id = 27, Type = EvtType.Battle,     Significance = 10, MangaRef = "Vol. 20\u201321, Ch. 82\u201384" },
        new() { Id = 28, Type = EvtType.Political,  Significance = 10, MangaRef = "Vol. 21, Ch. 84" },
        new() { Id = 29, Type = EvtType.Revelation, Significance = 10, MangaRef = "Vol. 21\u201322, Ch. 85\u201386" },
