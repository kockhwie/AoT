@page "/story"
@page "/timeline"
@page "/{Lang}/story"
@page "/{Lang}/timeline"
@using AOT.Services
@implements IDisposable
@inject AppLocalizationService LocalizationService
@inject LanguageSwitchService LanguageSwitcher
@inject NavigationManager Nav

<PageTitle>@(IsStoryTab ? LocalizationService.GetString("StoryTabTitle") : LocalizationService.GetString("TimelineTabTitle")) - @LocalizationService.GetString("PageTitle")</PageTitle>

<div class="aot-page-container">
    <!-- Premium Obsidian Header Panel -->
    <div class="aot-story-header">
        <h1 class="aot-page-title uppercase">@LocalizationService.GetString("StoryPageHeader")</h1>
        <p class="aot-page-subtitle font-sans">@LocalizationService.GetString("StoryPageSub")</p>

        <!-- Toggle Switch Tab Container -->
        <div class="aot-tab-switcher">
            <button class="aot-tab-btn aot-btn @(IsStoryTab ? "active" : "") font-sans" @onclick='() => SwitchTab("story")'>
                <i class="ti ti-books"></i> @LocalizationService.GetString("StoryTabTitle")
            </button>
            <button class="aot-tab-btn aot-btn @(!IsStoryTab ? "active" : "") font-sans" @onclick='() => SwitchTab("timeline")'>
                <i class="ti ti-clock"></i> @LocalizationService.GetString("TimelineTabTitle")
            </button>
        </div>
    </div>

    <!-- Active View Area -->
    <div class="aot-view-content mt-6">
        @if (IsStoryTab)
        {
            <!-- Story Arcs View -->
            <div class="aot-story-grid">
                @foreach (var arc in _storyArcs)
                {
                    <div class="aot-arc-card comic-card">
                        <div class="aot-arc-card-face">
                            <div class="aot-arc-header">
                                <span class="aot-arc-vol font-sans">@LocalizationService.GetString(arc.ChaptersKey)</span>
                                <h2 class="aot-arc-title font-sans">@LocalizationService.GetString(arc.TitleKey)</h2>
                            </div>
                            <p class="aot-arc-desc font-sans">@LocalizationService.GetString(arc.DescKey)</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Chronological Timeline View, grouped into eras -->
            <div class="aot-timeline-container">
                @foreach (var era in EraGroups)
                {
                    <h4 class="manga-arc-title font-sans">@LocalizationService.GetString(era.TitleKey)</h4>
                    <ul class="timeline timeline-vertical timeline-compact aot-timeline-era-list">
                        @for (int i = 0; i < era.Events.Count; i++)
                        {
                            var evt = era.Events[i];
                            <li>
                                @if (i > 0)
                                {
                                    <hr class="timeline-connector" />
                                }
                                <div class="timeline-middle timeline-icon @IconColorClass(evt.Type)">
                                    <i class="ti @IconClass(evt.Type)"></i>
                                </div>
                                <div class="timeline-end aot-timeline-box">
                                    <div class="aot-timeline-box-top">
                                        <time class="aot-timeline-time font-sans">@YearDisplay(evt)</time>
                                        <span class="comic-badge @SigBadgeClass(evt.Significance) aot-timeline-sig">
                                            <i class="ti ti-star-filled"></i>@evt.Significance
                                        </span>
                                    </div>
                                    <div class="aot-timeline-title font-sans">@LocalizationService.GetString(evt.TitleKey)</div>
                                    <span class="comic-tag aot-timeline-type font-sans">@LocalizationService.GetString(TypeLabelKey(evt.Type))</span>
                                    <p class="aot-timeline-desc font-sans">@LocalizationService.GetString(evt.DescKey)</p>
                                    @{
                                        var vol = ParseVolume(evt.MangaRef);
                                    }
                                    @if (vol is not null && MangaData.FindVolume(vol.Value) is not null)
                                    {
                                        <a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/manga/@vol" class="aot-btn aot-btn--xsm aot-btn--white aot-timeline-mangalink">
                                            <i class="ti ti-book"></i> @evt.MangaRef
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="aot-timeline-mangaref font-sans"><i class="ti ti-book"></i> @evt.MangaRef</span>
                                    }
                                </div>
                                @if (i < era.Events.Count - 1)
                                {
                                    <hr class="timeline-connector" />
                                }
                            </li>
                        }
                    </ul>
                }
            </div>

            <!-- Curse of Ymir deep-dive panel -->
            <div class="curse-panel comic-card mt-8">
                <div class="curse-panel-inner">
                    <h3 class="curse-panel-title font-sans"><i class="ti ti-hourglass-low"></i> @LocalizationService.GetString("CurseTitle")</h3>
                    <p class="curse-intro font-sans">@LocalizationService.GetString("CurseIntro")</p>

                    <div class="curse-facts-grid">
                        @foreach (var fact in _curseFacts)
                        {
                            <div class="curse-fact-row">
                                <span class="curse-fact-label font-sans">@LocalizationService.GetString(fact.LabelKey)</span>
                                <p class="curse-fact-value font-sans">@LocalizationService.GetString(fact.ValueKey)</p>
                            </div>
                        }
                    </div>

                    <h4 class="curse-table-title font-sans">@LocalizationService.GetString("CurseExamplesTitle")</h4>
                    <div class="curse-table-wrap">
                        <table class="curse-table font-sans">
                            <thead>
                                <tr>
                                    <th>@LocalizationService.GetString("CurseColShifter")</th>
                                    <th>@LocalizationService.GetString("CurseColInherited")</th>
                                    <th>@LocalizationService.GetString("CurseColDied")</th>
                                    <th>@LocalizationService.GetString("CurseColLifespan")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ex in _curseExamples)
                                {
                                    <tr>
                                        <td>@LocalizationService.GetString(ex.NameKey)</td>
                                        <td>@ex.Inherited</td>
                                        <td>@ex.Died</td>
                                        <td>@LocalizationService.GetString(ex.NoteKey)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Lang { get; set; }

    private bool IsStoryTab => Nav.Uri.EndsWith("/story", StringComparison.OrdinalIgnoreCase) || Nav.Uri.Contains("/story?", StringComparison.OrdinalIgnoreCase);

    private sealed class StoryArcModel
    {
        public string TitleKey { get; init; } = "";
        public string ChaptersKey { get; init; } = "";
        public string DescKey { get; init; } = "";
    }

    private readonly List<StoryArcModel> _storyArcs = new()
    {
        new StoryArcModel { TitleKey = "Arc1Title", ChaptersKey = "Arc1Chapters", DescKey = "Arc1Desc" },
        new StoryArcModel { TitleKey = "Arc2Title", ChaptersKey = "Arc2Chapters", DescKey = "Arc2Desc" },
        new StoryArcModel { TitleKey = "Arc3Title", ChaptersKey = "Arc3Chapters", DescKey = "Arc3Desc" },
        new StoryArcModel { TitleKey = "Arc4Title", ChaptersKey = "Arc4Chapters", DescKey = "Arc4Desc" },
