@page "/manga/{VolumeNumber:int}"
@using AOT.Services
@inject NavigationManager Nav
@inject AppLocalizationService LocalizationService
@inject LanguageSwitchService LanguageSwitcher
@implements IDisposable

<div>
    <a href="@Nav.ToAbsoluteUri("/manga")" class="aot-btn aot-btn--white"><i class="ti ti-caret-left"></i> @LocalizationService.GetString("MangaAllVolumesTitle")</a>
</div>

@if (_volume is not null)
{
    // var arcDisplayName = string.Join(" <br /> ", _volume.Arcs.Select(a => LocalizationService.GetString(MangaData.ArcNameKeys[a])));
    var arcNamesList    = _volume.Arcs
                            .Select(a => LocalizationService.GetString(MangaData.ArcNameKeys[a]))
                            .ToList();

    <PageTitle>Volume @_volume.VolumeNumber</PageTitle>

    <div>
        <h3 class="aot-section-title mb-6">
            <i class="ti ti-book"></i> Volume @_volume.VolumeNumber <span class="text-gray-400 text-lg ml-2 font-normal"></span>
        </h3>

        <div class="manga-detail-layout">
            <div class="manga-detail-sidebar">
                <img src="/img/manga/volumes/@_volume.CoverImage" alt="Vol. @_volume.VolumeNumber" class="manga-detail-sidebar-cover" />
                <div class="manga-detail-sidebar-meta">
                    <div class="flex gap-1 text-yellow-400 text-lg justify-center xl:justify-start">
                        @for (int i = 0; i < 5; i++)
                        {
                            if (i < Math.Round(_volume.DisplayRating))
                            {
                                <i class="ti ti-star-filled"></i>
                            }
                            else
                            {
                                <i class="ti ti-star"></i>
                            }
                        }
                    </div>

                    @foreach (var name in arcNamesList)
                    {
                        <p class="manga-detail-sidebar-chapters">@name</p>
                    }
                     <span class="manga-detail-sidebar-chapters">@_volume.Chapters.Count @LocalizationService.GetString("lblChapters")</span>
                </div>
            </div>

            <div class="manga-detail-content">
                <div class="manga-chapter-grid">
                    @foreach (var chapter in _volume.Chapters)
                    {
                        <div class="manga-chapter-card">
                            <div class="manga-chapter-header">
                                <h3 class="manga-chapter-title">@chapter.ChapterLabel</h3>
                            </div>
                            <div class="manga-chapter-moments">
                                @foreach (var moment in chapter.KeyMoments)
                                {
                                    <div class="manga-chapter-moment">@moment</div>
                                }
                            </div>
                            <div class="manga-chapter-tags">
                                @foreach (var tag in chapter.Tags)
                                {
                                    <span class="comic-badge comic-badge--accent">@tag</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="flex justify-between items-center px-4 py-8 max-w-[1200px] mx-auto">
        @if (VolumeNumber > 1)
        {
            <a href="/manga/@(VolumeNumber - 1)" class="aot-btn aot-btn--white"><i class="ti ti-caret-left"></i> @LocalizationService.GetString("lblPreviousVolume")</a>
        }
        else
        {
            <div></div>
        }
        
        @if (VolumeNumber < AOT.Services.MangaData.Volumes.Count)
        {
            <a href="/manga/@(VolumeNumber + 1)" class="aot-btn aot-btn--white">@LocalizationService.GetString("lblNextVolume") <i class="ti ti-caret-right"></i></a>
        }
        else
        {
            <div></div>
        }
    </div>
}

@code {
    [Parameter] public int VolumeNumber { get; set; }
    [CascadingParameter] public string CurrentLang { get; set; } = "zh";
    private MangaVolumeModel? _volume;

    protected override void OnParametersSet()
    {
        _volume = MangaData.FindVolume(VolumeNumber);
        if (_volume is null)
        {
            Nav.NavigateTo("/not-found");
        }
    }

    protected override void OnInitialized()
    {
        // Subscribe to language changes
        LanguageSwitcher.OnLanguageChanged += HandleLanguageChanged;
    }

    private void HandleLanguageChanged(string newLanguage)
    {
        // Trigger re-render when language changes
        StateHasChanged();
    }

    public void Dispose()
    {
        // Unsubscribe to prevent memory leaks
        LanguageSwitcher.OnLanguageChanged -= HandleLanguageChanged;
    }
}
