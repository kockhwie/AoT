<script>

    (function () {
        // Detect touch-primary device (iPhone, Android, iPad)
        const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);

        document.querySelectorAll('.hype-card-container').forEach(container => {
            const card = container.querySelector('.titan-hype-card, .member-hype-card:not(.character-card)');
            if (!card) return;
            const foil = container.querySelector('.holo-foil-layer');

            /* ======================================================================
               DESKTOP — smooth JS-driven 3D tilt + foil tracking (unchanged)
               ====================================================================== */
            if (!isTouchDevice) {
                let rafId = null;
                let targetTiltX = 0, targetTiltY = 0;
                let currentTiltX = 0, currentTiltY = 0;
                let foilX = 50, foilY = 50;
                let isHovered = false;

                // Lerp the tilt values each frame for ultra-smooth motion
                function lerp(a, b, t) { return a + (b - a) * t; }

                function animateFrame() {
                    currentTiltX = lerp(currentTiltX, targetTiltX, 0.12);
                    currentTiltY = lerp(currentTiltY, targetTiltY, 0.12);
                    card.style.transform = `translateY(-10px) rotateX(${currentTiltX}deg) rotateY(${currentTiltY}deg) translateZ(0)`;
                    if (foil) {
                        foil.style.backgroundPosition = `${foilX}% ${foilY}%`;
                    }
                    if (isHovered) rafId = requestAnimationFrame(animateFrame);
                }

                container.addEventListener('mouseenter', () => {
                    isHovered = true;
                    if (foil) foil.style.opacity = '0.8';
                    rafId = requestAnimationFrame(animateFrame);
                });

                container.addEventListener('mousemove', (e) => {
                    const rect = container.getBoundingClientRect();
                    const x = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                    const y = Math.max(0, Math.min(1, (e.clientY - rect.top)  / rect.height));
                    targetTiltX = (0.5 - y) * 24;
                    targetTiltY = (x - 0.5) * 24;
                    foilX = x * 100;
                    foilY = y * 100;
                });

                container.addEventListener('mouseleave', () => {
                    isHovered = false;
                    cancelAnimationFrame(rafId);
                    targetTiltX = 0; targetTiltY = 0;
                    currentTiltX = 0; currentTiltY = 0;
                    card.style.transform = 'translateY(0px) rotateX(0deg) rotateY(0deg) translateZ(0)';
                    if (foil) foil.style.opacity = '0';
                });

            /* ======================================================================
               MOBILE — CSS-only tap feedback (transform + opacity only = GPU)
               Character: "Survey Lock-On" snap + sensor sweep (no 3D tilt / box-shadow anim)
               Titan: keeps gold tapShimmer + foilSweep
               ====================================================================== */
            } else {
                const isMember = card.classList.contains('member-hype-card');

                container.addEventListener('touchstart', () => {
                    card.classList.remove('is-tapped');
                    void card.offsetWidth;
                    card.classList.add('is-tapped');
                }, { passive: true });

                card.addEventListener('animationend', (e) => {
                    const done = isMember
                        ? e.animationName === 'memberTapSnap'
                        : e.animationName === 'tapShimmer';
                    if (done) card.classList.remove('is-tapped');
                });
            }
        });
    })();

</script>

@code {
    /// <summary>URL locale segment — set by Blazor router from /{Lang} route.</summary>
    [Parameter] public string Lang { get; set; } = "zh";

    // Manga Slide Model
    private sealed class MangaSlideModel
    {
        public string TitleKey { get; init; } = "";
        public string Chapter { get; init; } = "";
        public string QuoteKey { get; init; } = "";
        public string Image { get; init; } = "";
        public string MangaPath { get; init; } = "";
        // object-position for the background art — lets a slide whose subject sits off-center
        // (e.g. panels with the character on the right third) stay in frame as the container
        // narrows on mobile, without needing a separately-cropped image export.
        public string FocalPosition { get; init; } = "center";
    }

    private List<MangaSlideModel> _mangaSlides = new();
    private int _currentSlideIndex = 0;
    private System.Threading.Timer? _autoPlayTimer;
    private double _touchStartX = 0;
    private double _tiltX = 0;
    private double _tiltY = 0;
    private int _activeCharacterIndex = 0;
    private int _pinnedCharacterIndex = -1;
    private int _hoveredCharacterIndex = -1;
    private int _flippedCharacterIndex = -1;
    private double _characterTouchStartX = 0;

    private int? _pulledVolumeNumber; // no volume pre-opened — random set has no obvious "first"
    private List<MangaVolumeModel> _teaserVolumes = new();
 
    private readonly HashSet<string> _activeTagFilters = new();

    private void TogglePulledVolume(int volumeNumber)
    {
        _pulledVolumeNumber = _pulledVolumeNumber == volumeNumber ? null : volumeNumber;
    }

    private void ToggleTagFilter(string tag)
    {
        if (!_activeTagFilters.Remove(tag))
        {
            _activeTagFilters.Add(tag);
        }
    }


    protected override void OnParametersSet()
    {
        // Seed language from the URL segment (e.g. /en/ → "en")
        if (!string.IsNullOrEmpty(Lang))
            LanguageSwitcher.Initialize(Lang);
    }

    protected override void OnInitialized()
    {

        // Subscribe to language changes to rebuild slides with new quotes
        LanguageSwitcher.OnLanguageChanged += HandleLanguageChanged;

        _mangaSlides = BuildMangaSlides();

        _activeCharacterIndex = Math.Min((_characterDatabase.Count - 1) / 2, _characterDatabase.Count - 1);

        // Initialize 7s autoplay rotation loop
        _autoPlayTimer = new System.Threading.Timer(AutoPlayTick, null, 7000, 7000);

        // Random.Shared is thread-safe across concurrent Blazor Server circuits —
        // a shared `Random` instance field here would race across users.
        //_teaserVolumes = MangaData.Volumes.OrderBy(_ => Random.Shared.Next()).Take(34).ToList();
        // i dun want to use random, i want it sort the book by volume number, so the first 34 volumes are shown in order
        _teaserVolumes = MangaData.Volumes.OrderBy(v => v.VolumeNumber).Take(34).ToList();

    }

    private void AutoPlayTick(object? state)
    {
        InvokeAsync(() =>
        {
            NextSlide();
            StateHasChanged();
        });
    }

    private void PrevSlide()
    {
        ResetAutoplay();
        _currentSlideIndex = _currentSlideIndex == 0 ? _mangaSlides.Count - 1 : _currentSlideIndex - 1;
    }

    private void NextSlide()
    {
        ResetAutoplay();
        _currentSlideIndex = (_currentSlideIndex + 1) % _mangaSlides.Count;
    }

    private void SetSlide(int index)
    {
        ResetAutoplay();
        _currentSlideIndex = index;
    }

    private void ResetAutoplay()
    {
        _autoPlayTimer?.Change(7000, 7000);
    }

    private void HandleTouchStart(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            _touchStartX = e.Touches[0].ClientX;
        }
    }

    private void HandleTouchEnd(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (e.ChangedTouches.Length > 0)
        {
            var deltaX = e.ChangedTouches[0].ClientX - _touchStartX;
            // threshold of 60px swipe delta
            if (deltaX > 60)
            {
                PrevSlide();
            }
            else if (deltaX < -60)
            {
                NextSlide();
            }
        }
    }

    private void HandleMouseMove(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        // Calculate tilt between -10 to +10 degrees based on cursor position relative to window bounds
        // (Rough normalization for slider bounds)
        double width = 1200; // estimated width
        double height = 500; // estimated height

        _tiltY = -((e.OffsetX - (width / 2)) / (width / 2)) * 8;
        _tiltX = ((e.OffsetY - (height / 2)) / (height / 2)) * 8;
    }

    private void HandleMouseLeave(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
    {
        _tiltX = 0;
        _tiltY = 0;
    }

    private void SetHoveredCharacter(int index)
    {
        _hoveredCharacterIndex = index;
        if (_pinnedCharacterIndex < 0)
        {
            _activeCharacterIndex = index;
        }
    }

    private void ClearHoveredCharacter()
    {
        _hoveredCharacterIndex = -1;
        if (_pinnedCharacterIndex < 0)
        {
            _activeCharacterIndex = Math.Clamp(_activeCharacterIndex, 0, _characterDatabase.Count - 1);
        }
    }

    private void ToggleCharacterCard(int index)
    {
        if (_pinnedCharacterIndex != index)
        {
            _pinnedCharacterIndex = index;
            _activeCharacterIndex = index;
            _flippedCharacterIndex = -1;
            return;
        }

        _flippedCharacterIndex = _flippedCharacterIndex == index ? -1 : index;
    }

    private void ClearPinnedCharacter()
    {
        _pinnedCharacterIndex = -1;
        _hoveredCharacterIndex = -1;
        _flippedCharacterIndex = -1;
    }

    private void HandleCharacterCarouselWheel(Microsoft.AspNetCore.Components.Web.WheelEventArgs e)
    {
        _pinnedCharacterIndex = -1;
        _flippedCharacterIndex = -1;

        if (e.DeltaY > 0)
        {
            _activeCharacterIndex = (_activeCharacterIndex + 1) % _characterDatabase.Count;
        }
        else if (e.DeltaY < 0)
        {
            _activeCharacterIndex = _activeCharacterIndex == 0 ? _characterDatabase.Count - 1 : _activeCharacterIndex - 1;
        }

    }

    private void HandleCharacterTouchStart(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (e.Touches.Length > 0)
        {
            _characterTouchStartX = e.Touches[0].ClientX;
        }
    }

    private void HandleCharacterTouchEnd(Microsoft.AspNetCore.Components.Web.TouchEventArgs e)
    {
        if (e.ChangedTouches.Length == 0)
        {
            return;
        }

        var deltaX = e.ChangedTouches[0].ClientX - _characterTouchStartX;

        if (Math.Abs(deltaX) > 50)
        {
            _pinnedCharacterIndex = -1;
            _flippedCharacterIndex = -1;

            if (deltaX < 0)
            {
                _activeCharacterIndex = (_activeCharacterIndex + 1) % _characterDatabase.Count;
            }
            else
            {
                _activeCharacterIndex = _activeCharacterIndex == 0 ? _characterDatabase.Count - 1 : _activeCharacterIndex - 1;
            }
        }
    }

    private string GetCharacterPosition(int relativeIndex) => relativeIndex switch
    {
        <= -3 => "far-left",
        -2 => "left",
        -1 => "near-left",
        0 => "center",
        1 => "near-right",
        2 => "right",
        _ => "far-right"
    };

    public void Dispose()
    {
        _autoPlayTimer?.Dispose();
        // Unsubscribe from language changes to prevent memory leaks
        LanguageSwitcher.OnLanguageChanged -= HandleLanguageChanged;
    }

    /// <summary>
    /// Handle language changes by rebuilding the manga slides with new localized quotes
    /// </summary>
    private void HandleLanguageChanged(string newLanguage)
    {
        // Rebuild slides with new language
        _mangaSlides = BuildMangaSlides();
        StateHasChanged();
    }

