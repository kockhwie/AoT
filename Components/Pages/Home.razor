    //核心：定義兵團角色輕量級數據模型
    private sealed class CharacterModel
    {
        public string NameKey { get; init; } = "";
        public string TitleKey { get; init; } = "";
        public string BioKey { get; init; } = "";
        public string AbilityKey { get; init; } = "";
        public string Rank { get; init; } = "A";
        public string Theme { get; init; } = "";
        // ponytail: rank drives card/badge color now (standardized rank palette), not per-character Theme
        public string RankClass => Rank switch
        {
            "S-RANK" => "rank-s",
            "A+RANK" => "rank-a-plus",
            _ => "rank-a"
        };
        public string Portrait { get; init; } = "";
        // object-position override for the portrait crop, e.g. "center 25%". Null = CSS
        // default (center top). Same idea as MangaSlideModel.FocalPosition above — lets a
        // portrait whose face isn't near the top of the source image stay in frame.
        public string? FocalPosition { get; init; }
        public string Kills { get; init; } = "0";
        public int KillsPct { get; init; }       // 0-100 for progress bar
        public int Wits { get; init; }            // 0-10
        public bool IsTitanShifter { get; init; }
    }

