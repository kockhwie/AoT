@page "/"
@inject AppLocalizationService LocalizationService

<!-- 区域 1：顶部核心巨幕区 -->
<div class="aot-hero">
    <div>
        <span class="aot-hero-badge">
            @LocalizationService.GetString("HeroTag")
        </span>
        <h1 class="aot-hero-title">
            @LocalizationService.GetString("HeroTitle")
        </h1>
        <p class="aot-hero-desc">
            @LocalizationService.GetString("HeroDesc")
        </p>
        <div class="aot-hero-actions">
            <button class="btn btn-xs md:btn-sm aot-hero-btn btn-primary">@LocalizationService.GetString("BtnIntel")</button>
            <button class="btn btn-xs md:btn-sm aot-hero-btn btn-outline btn-secondary">@LocalizationService.GetString("BtnGallery")</button>
        </div>
    </div>
</div>

<!-- 區域 2：調查兵團精銳作戰檔案  -->
<div class="flex flex-col gap-2 mt-6">
    <h3 class="aot-section-title">
        <i class="ti ti-swords"></i> @LocalizationService.GetString("SectionTitle")       
    </h3>
    
    <div class="aot-card-grid">
        @foreach (var member in _characterDatabase)
        {
            <div class="aot-card">
                <div class="aot-card-body">
                    <div class="aot-card-header">
                        <div>
                            <h4 class="aot-char-name">@LocalizationService.GetString(member.NameKey)</h4>
                            <span class="aot-char-title">@LocalizationService.GetString(member.TitleKey)</span>
                        </div>
                        <div class="badge badge-outline badge-error aot-char-badge">@member.Rank</div>
                    </div>
                    <p class="aot-char-bio">
                        @LocalizationService.GetString(member.BioKey)
                    </p>
                    <div class="divider aot-card-divider"></div>
                    <div class="aot-char-stats">
                        <div><span class="aot-stat-label">@LocalizationService.GetString("StatKills"):</span> <span class="aot-stat-val text-error">@member.Kills</span></div>
                        <div><span class="aot-stat-label">@LocalizationService.GetString("StatWits"):</span> <span class="aot-stat-val text-success">@member.Wits/10</span></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- 新增区域 3：九大巨人能力图谱面板   -->
<div class="flex flex-col gap-2">
    <h3 class="aot-section-title">
        <i class="ti ti-dna-2"></i> @LocalizationService.GetString("TitanSectionTitle")
    </h3>
    
    <div class="titan-registry-grid">
        @foreach (var titan in _titanDatabase)
        {
            <div class="hype-card-container">
                <div class="titan-hype-card theme-@titan.Theme">

                    <!-- Holographic Flare Overlay Sheets -->
                    <div class="holo-foil-layer"></div>
                    <div class="hologram-scanlines"></div>

                    <!-- Top Row Meta Registry Labels -->
                    <div class="meta-registry-row">
                        <span class="registry-serial"></span>
                        <div class="class-node">@LocalizationService.GetString(titan.Theme)</div>
                    </div>

                    <!-- Clean Full-Width Header Title -->
                    <div class="chassis-header">
                        <div class="title-container">
                            <h2 class="titan-display-title">@LocalizationService.GetString(titan.NameKey)</h2>
                        </div>
                    </div>

                    <!-- Centerpiece Immersive Image Window -->
                    <div class="artwork-glass-frame">
                        <div class="glass-reflection"></div>
                        <img src="/img/titans/cards/@titan.TypeBadge" class="chassis-art" alt="@titan.TypeBadge" />
                        <div class="laser-gold-trim"></div>
                    </div>

                    <!-- Spec Analytics Dashboard Grid -->
                    <div class="specs-dashboard-grid">
                        <div class="spec-node"></div>
                        <div class="spec-node align-right"> 
                            <div class="node-hdr">@LocalizationService.GetString(titan.HeightKey)</div>                                
                        </div>
                    </div>                        

                    <!-- Lore Paragraph Text Box -->
                    <div class="lore-summary-area">
                        <p class="lore-text-body">
                            @LocalizationService.GetString(titan.DescKey)
                        </p>
                    </div>

                    <div class="chassis-divider"></div>

                    <div class="titan-stats-container">
                        <!-- 力量指标 -->
                        <div>
                            <div class="titan-stat-row">
                                <span class="badge-label">@LocalizationService.GetString("ParamPower")</span>
                                <span class="text-primary font-bold">@titan.Power%</span>
                            </div>
                            <progress class="progress progress-primary w-full" value="@titan.Power" max="100"></progress>
                        </div>

                        <!-- 速度指标 -->
                        <div>
                            <div class="titan-stat-row">
                                <span class="badge-label">@LocalizationService.GetString("ParamSpeed")</span>
                                <span class="text-secondary font-bold">@titan.Speed%</span>
                            </div>
                            <progress class="progress progress-secondary w-full " value="@titan.Speed" max="100"></progress>
                        </div>

                        <!-- 硬度/特殊能力指标 -->
                        <div>
                            <div class="titan-stat-row">
                                <span class="badge-label">@LocalizationService.GetString("ParamArmor")</span>
                                <span class="text-accent font-bold">@titan.Armor%</span>
                            </div>
                            <progress class="progress progress-accent w-full align-right" value="@titan.Armor" max="100"></progress>
                        </div>
                    </div>

                </div>
            </div>               
        }
    </div>
</div>

<!-- 區域 4：兵團戰術裝備與牆外調查資產 -->
<div class="flex flex-col gap-2 mt-6">
    <h3 class="aot-section-title">
        <i class="ti ti-settings"></i>@LocalizationService.GetString("GearSectionTitle")
    </h3>

    <div class="aot-gear-grid">
        @foreach (var gear in _gearDatabase)
        {
            <div class="aot-gear-card gear-theme-@gear.ClassBadge.ToLower().Replace("_", "-")">
                <div class="aot-gear-header">
                    <h4 class="aot-gear-title">@LocalizationService.GetString(gear.NameKey)</h4>
                    <div class="badge badge-outline badge-accent aot-gear-badge">@LocalizationService.GetString(gear.ClassBadge)</div>
                </div>
                
                <div class="aot-gear-tech">
                    @LocalizationService.GetString(gear.TechKey)
                </div>

                <p class="aot-gear-desc">
                    @LocalizationService.GetString(gear.DescKey)
                </p>

                <div class="divider aot-card-divider"></div>

                <div class="aot-gear-specs">
                    <div><span>@LocalizationService.GetString("SpecWeight"):</span> <span class="text-white">@gear.WeightSpec</span></div>
                    <div><span>@LocalizationService.GetString("SpecRisk"):</span> <span class="text-error font-bold">@gear.RiskLevel</span></div>
                </div>
            </div>
        }
    </div>
</div>

<!-- 区域 5：编年史时间轴区 -->
<div class="flex flex-col gap-2 mt-6">
    <h3 class="aot-section-title">
        <i class="ti ti-clock"></i> @LocalizationService.GetString("TimelineHeader")
    </h3>
    <div class="aot-timeline-card">
        <ul class="timeline timeline-vertical timeline-compact">
            <li>
                <div class="timeline-middle text-error">📍</div>
                <div class="timeline-end aot-timeline-box">
                    <time class="aot-timeline-time">845 年</time>
                    <div class="aot-timeline-title">@LocalizationService.GetString("Time1Title")</div>
                    <p class="aot-timeline-desc">@LocalizationService.GetString("Time1Desc")</p>
                </div>
                <hr class="bg-primary/30" />
            </li>
            <li>
                <hr class="bg-primary/30" />
                <div class="timeline-middle text-warning">📍</div>
                <div class="timeline-end aot-timeline-box">
                    <time class="aot-timeline-time">854 年</time>
                    <div class="aot-timeline-title">@LocalizationService.GetString("Time2Title")</div>
                    <p class="aot-timeline-desc">@LocalizationService.GetString("Time2Desc")</p>
                </div>
            </li>
        </ul>
    </div>
</div>

<script>

    (function () {
        // Detect touch-primary device (iPhone, Android, iPad)
        const isTouchDevice = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);

        document.querySelectorAll('.hype-card-container').forEach(container => {
            const card = container.querySelector('.titan-hype-card');
            const foil = container.querySelector('.holo-foil-layer');

            /* ======================================================================
               DESKTOP — smooth JS-driven 3D tilt + foil tracking (unchanged)
               ====================================================================== */
            if (!isTouchDevice) {
                let rafId = null;
                let targetTiltX = 0, targetTiltY = 0;
                let currentTiltX = 0, currentTiltY = 0;
                let foilX = 50, foilY = 50;
                let isHovered = false;

                // Lerp the tilt values each frame for ultra-smooth motion
                function lerp(a, b, t) { return a + (b - a) * t; }

                function animateFrame() {
                    currentTiltX = lerp(currentTiltX, targetTiltX, 0.12);
                    currentTiltY = lerp(currentTiltY, targetTiltY, 0.12);
                    card.style.transform = `translateY(-10px) rotateX(${currentTiltX}deg) rotateY(${currentTiltY}deg) translateZ(0)`;
                    if (foil) {
                        foil.style.backgroundPosition = `${foilX}% ${foilY}%`;
                    }
                    if (isHovered) rafId = requestAnimationFrame(animateFrame);
                }

                container.addEventListener('mouseenter', () => {
                    isHovered = true;
                    if (foil) foil.style.opacity = '0.8';
                    rafId = requestAnimationFrame(animateFrame);
                });

                container.addEventListener('mousemove', (e) => {
                    const rect = container.getBoundingClientRect();
                    const x = Math.max(0, Math.min(1, (e.clientX - rect.left) / rect.width));
                    const y = Math.max(0, Math.min(1, (e.clientY - rect.top)  / rect.height));
                    targetTiltX = (0.5 - y) * 24;
                    targetTiltY = (x - 0.5) * 24;
                    foilX = x * 100;
                    foilY = y * 100;
                });

                container.addEventListener('mouseleave', () => {
                    isHovered = false;
                    cancelAnimationFrame(rafId);
                    targetTiltX = 0; targetTiltY = 0;
                    currentTiltX = 0; currentTiltY = 0;
                    card.style.transform = 'translateY(0px) rotateX(0deg) rotateY(0deg) translateZ(0)';
                    if (foil) foil.style.opacity = '0';
                });

            /* ======================================================================
               MOBILE — CSS keyframe tap burst (no JS tracking = zero lag)
               goldBreath ambient pulse runs automatically from CSS.
               A tap fires tapShimmer + foilSweep entirely on the GPU.
               ====================================================================== */
            } else {
                container.addEventListener('touchstart', () => {
                    // Cancel any running animation so it restarts cleanly on rapid taps
                    card.classList.remove('is-tapped');
                    // Force a reflow so removing + re-adding the class re-triggers the animation
                    void card.offsetWidth;
                    card.classList.add('is-tapped');
                }, { passive: true });

                // Clean up after the burst animation ends — ambient breath resumes automatically
                card.addEventListener('animationend', (e) => {
                    if (e.animationName === 'tapShimmer') {
                        card.classList.remove('is-tapped');
                    }
                });
            }
        });
    })();

</script>

