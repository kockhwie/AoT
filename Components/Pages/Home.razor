<!-- Randomized Quote Script Engine -->
<script>
  var aotQuotePool = [
    { text: '"If you win, you live. If you lose, you die. If you don\'t fight, you can\'t win!"', auth: '— Eren Yeager // Vol. 3 / CH. 10' },
    { text: '"Someone who cannot sacrifice anything, can never change anything."', auth: '— Armin Arlert // Vol. 20 / CH. 81' },
    { text: '"Give up on your dreams and die. Lead the recruits straight into hell."', auth: '— Levi Ackerman // Vol. 20 / CH. 80' },
    { text: '"My soldiers, rage! My soldiers, scream! My soldiers, fight!"', auth: '— Erwin Smith // Vol. 20 / CH. 80' },
    { text: '"This world is cruel, and it\'s also very beautiful."', auth: '— Mikasa Ackerman // Vol. 2 / CH. 7' },
    { text: '"If you don\'t want to die... think. Even if it\'s just a tiny spark, find a way out."', auth: '— Hange Zoe // Vol. 14 / CH. 57' },
    { text: '"The only thing we\'re allowed to do... is to believe that we won\'t regret the choice we made."', auth: '— Levi Ackerman // Vol. 6 / CH. 25' }
  ];

  function generateRandomAotQuote() {
    var textEl = document.getElementById('aot-quote-text');
    var authEl = document.getElementById('aot-quote-author');
    
    // Quick fade out effect wrapper
    textEl.style.opacity = '0';
    authEl.style.opacity = '0';
    
    setTimeout(function() {
      var randIndex = Math.floor(Math.random() * aotQuotePool.length);
      var currentQuote = aotQuotePool[randIndex];
      
      textEl.innerText = currentQuote.text;
      authEl.innerText = currentQuote.auth;
      
      textEl.style.opacity = '1';
      authEl.style.opacity = '1';
    }, 150);
  }

  // Self-execute on load to randomize on first screen hit
  window.addEventListener('DOMContentLoaded', function() {
    generateRandomAotQuote();
  });
</script>


<!-- 新增区域 3：九大巨人能力图谱面板   -->
<div id="character-cards-section" class="flex flex-col gap-2">
    <h3 class="aot-section-title">
        <i class="ti ti-swords"></i> @LocalizationService.GetString("SectionTitle")
    </h3>

    <div class="character-carousel-shell">
        <div class="character-carousel-stage"
             @onwheel="HandleCharacterCarouselWheel"
             @ontouchstart="HandleCharacterTouchStart"
             @ontouchend="HandleCharacterTouchEnd">
            @for (var i = 0; i < _characterDatabase.Count; i++)
            {
                var index = i;
                var member = _characterDatabase[index];
                var relative = index - _activeCharacterIndex;
                var absDistance = Math.Abs(relative);
                var isActive = _pinnedCharacterIndex == index;
                var isFocused = _hoveredCharacterIndex == index || _activeCharacterIndex == index || isActive;
                var positionClass = $"is-{GetCharacterPosition(relative)}";
                var itemClass = $"hype-card-container character-carousel-item {positionClass} {(isActive ? "is-pinned" : "")}";
                var cardClass = $"member-hype-card comic-card character-card {(isActive ? "is-pinned" : "")} {(isFocused ? "is-focused" : "")} {(_flippedCharacterIndex == index ? "is-flipped" : "")}";
                var cardStyle = $"--card-offset:{relative}; --card-depth:{absDistance};";

                <button type="button"
                        class="@itemClass"
                        style="@cardStyle"
                        aria-pressed="@(isActive ? "true" : "false")"
                        @onclick="() => ToggleCharacterCard(index)"
                        @onmouseenter="() => SetHoveredCharacter(index)"
                        @onmouseleave="ClearHoveredCharacter">
                    <div class="@cardClass">
                        <div class="character-card-face character-card-front">
                            <div class="holo-foil-layer"></div>
                            <div class="hologram-scanlines"></div>
                            <div class="tcg-topbar">
