@page "/{Lang}"
@inject AppLocalizationService LocalizationService
@using AOT.Services
@inject LanguageSwitchService LanguageSwitcher
@inject NavigationManager Nav
@implements IDisposable

<!-- 区域 1：顶部核心巨幕区 (互动式漫画分镜带) -->
<div class="manga-slider-container"
     @ontouchstart="HandleTouchStart"
     @ontouchend="HandleTouchEnd"
     @onmousemove="HandleMouseMove"
     @onmouseleave="HandleMouseLeave"
     style="--tilt-x: @(_tiltX)deg; --tilt-y: @(_tiltY)deg;"
     tabindex="0"
     aria-label="Manga Comic Panel Story Slider">

    <!-- Inner wrapper with hidden overflow to prevent slides from bleeding out, while letting arrows overflow -->
    <div style="position: absolute; inset: 0; overflow: hidden; border-radius: inherit;">
        <div class="manga-screentone-overlay"></div>

        @for (int i = 0; i < _mangaSlides.Count; i++)
        {
            var slide = _mangaSlides[i];
            var index = i;
            <div class="manga-slide @(index == _currentSlideIndex ? "active" : "")">
                <!-- Background Image -->
                <img src="/img/manga/@slide.Image" class="manga-bg-art" style="object-position: @slide.FocalPosition" alt="@LocalizationService.GetString(slide.TitleKey)" />
                <div class="manga-vignette"></div>

                <!-- Manga Speech Bubble / Combat Telemetry Panel -->
                <div class="manga-telemetry-panel">
                    <a href="@slide.MangaPath" class="aot-btn aot-btn--yellow" aria-label="Explore chapter details">
                        <i class="ti ti-bookmark mr-1"></i>@slide.Chapter
                    </a>
                    <h1 class="manga-panel-title">
                        @LocalizationService.GetString(slide.TitleKey)
                    </h1>

                    <!-- Manga Quote Display -->
                    <blockquote class="manga-quote-block">
                        “@LocalizationService.GetString(slide.QuoteKey)”
                    </blockquote>
 

                </div>
            </div>
        }
    </div>

    <!-- Manual Navigation Arrows -->
    <button class="manga-nav-arrow prev" @onclick="PrevSlide" aria-label="Previous Slide">
        <i class="ti ti-chevron-left"></i>
    </button>
    <button class="manga-nav-arrow next" @onclick="NextSlide" aria-label="Next Slide">
        <i class="ti ti-chevron-right"></i>
    </button>

    <!-- Navigation Dots -->
    <div class="manga-slider-dots">
        @for (int i = 0; i < _mangaSlides.Count; i++)
        {
            var index = i;
            <span class="manga-dot @(index == _currentSlideIndex ? "active" : "")"
                  @onclick="() => SetSlide(index)"></span>
        }
    </div>
</div>

<!-- 新增区域 3：九大巨人能力图谱面板   -->
<div id="character-cards-section" class="flex flex-col gap-2">
    <h3 class="aot-section-title">
        <i class="ti ti-swords"></i> @LocalizationService.GetString("SectionTitle")
    </h3>

    <div class="character-carousel-shell">
        <div class="character-carousel-stage"
             @onwheel="HandleCharacterCarouselWheel"
             @ontouchstart="HandleCharacterTouchStart"
             @ontouchend="HandleCharacterTouchEnd">
            @for (var i = 0; i < _characterDatabase.Count; i++)
            {
                var index = i;
                var member = _characterDatabase[index];
                var relative = index - _activeCharacterIndex;
                var absDistance = Math.Abs(relative);
                var isActive = _pinnedCharacterIndex == index;
                var isFocused = _hoveredCharacterIndex == index || _activeCharacterIndex == index || isActive;
                var positionClass = $"is-{GetCharacterPosition(relative)}";
                var itemClass = $"hype-card-container character-carousel-item {positionClass} {(isActive ? "is-pinned" : "")}";
                var cardClass = $"member-hype-card comic-card character-card {(isActive ? "is-pinned" : "")} {(isFocused ? "is-focused" : "")} {(_flippedCharacterIndex == index ? "is-flipped" : "")}";
                var cardStyle = $"--card-offset:{relative}; --card-depth:{absDistance};";

                <button type="button"
                        class="@itemClass"
                        style="@cardStyle"
                        aria-pressed="@(isActive ? "true" : "false")"
                        @onclick="() => ToggleCharacterCard(index)"
                        @onmouseenter="() => SetHoveredCharacter(index)"
                        @onmouseleave="ClearHoveredCharacter">
                    <div class="@cardClass">
                        <div class="character-card-face character-card-front">
                            <div class="holo-foil-layer"></div>
                            <div class="hologram-scanlines"></div>
                            <div class="tcg-topbar">
                                <div class="meta-registry-row">
                                    <div class="member-rank-badge comic-badge @(member.RankClass == "rank-s" ? "comic-badge--gold" : member.RankClass == "rank-a-plus" ? "comic-badge--silver" : "comic-badge--bronze")">@member.Rank</div>
                                    @if (member.IsTitanShifter)
                                    {
                                        <div class="titan-shifter-badge comic-badge comic-badge--accent">TITAN SHIFTER</div>
                                    }
                                    else
                                    {
                                        <span class="registry-serial"></span>
                                    }
                                </div>
                            </div>

                            <div class="character-art-shell">
                                <div class="artwork-glass-frame comic-frame">
                                    <div class="glass-reflection"></div>
                                    <img src="/img/characters/@member.Portrait" class="chassis-art chassis-art--portrait"
                                         style="@(string.IsNullOrEmpty(member.FocalPosition) ? "" : $"object-position: {member.FocalPosition};")"
                                         alt="@LocalizationService.GetString(member.NameKey)" />
                                    <div class="member-tap-sweep" aria-hidden="true"></div>
                                    <div class="laser-rank-trim"></div>
                                </div>
                            </div>

                            <div class="character-front-copy">
                                <div class="chassis-header">
                                    <h2 class="member-display-name">@LocalizationService.GetString(member.NameKey)</h2>
                                    <div class="member-display-title">@LocalizationService.GetString(member.TitleKey)</div>
                                </div>
                                <div class="member-ability-row">
                                    <span class="member-ability-tag comic-tag">@LocalizationService.GetString(member.AbilityKey)</span>
                                </div>
                            </div>
                        </div>

                        <div class="character-card-face character-card-back">
                            <div class="back-card-header">
                                <div class="back-card-title"></div>
                                <div class="back-card-subtitle">@LocalizationService.GetString(member.NameKey)</div>
                            </div>

                            <div class="character-back-content">
                                <div class="lore-summary-area">
                                    <p class="lore-text-body">@LocalizationService.GetString(member.BioKey)</p>
                                </div>

                                <div class="chassis-divider"></div>

                                <div class="hype-stats-container">
                                    <div class="hype-stat-row">
                                        <div class="hype-stat-header">
                                            <span class="hype-stat-label">@LocalizationService.GetString("StatKillsBar")</span>
                                            <span class="hype-stat-pct text-error">@member.Kills</span>
                                        </div>
                                        <progress class="progress progress-xs progress-error w-full" value="@member.KillsPct" max="100"></progress>
                                    </div>
                                    <div class="hype-stat-row">
                                        <div class="hype-stat-header">
                                            <span class="hype-stat-label">@LocalizationService.GetString("StatWitsBar")</span>
                                            <span class="hype-stat-pct text-success">@member.Wits/10</span>
                                        </div>
                                        <progress class="progress progress-xs progress-success w-full" value="@(member.Wits * 10)" max="100"></progress>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </button>
            }
        </div>

        <!-- Lives outside .character-carousel-stage (which needs overflow:hidden to keep the
             off-screen carousel cards from widening the page) so it can never be clipped, and
             is styled to sit at the same spot the centered card occupies (see
             .flip-affordance-anchor, kept in sync with .character-carousel-item's own
             top/width per breakpoint). Only the centered/active card is realistically what a
             person is flipping, so one shared badge stands in for a per-card one. -->
        <div class="flip-affordance-anchor @(_pinnedCharacterIndex != -1 ? "is-visible" : "")" aria-hidden="true">
            <div class="flip-affordance @(_flippedCharacterIndex == _pinnedCharacterIndex ? "is-flipped-state" : "")">
                <i class="ti ti-rotate-360"></i>
            </div>
        </div>
    </div>
</div>

<div id="titan-cards-section" class="flex flex-col gap-2">
    <h3 class="aot-section-title">
        <i class="ti ti-dna-2"></i> @LocalizationService.GetString("TitanSectionTitle")
    </h3>

    <div class="registry-grid">
        @foreach (var titan in _titanDatabase)
        {
            <div class="hype-card-container">
                <div class="titan-hype-card theme-@titan.Theme">

                    <!-- Holographic Flare Overlay Sheets -->
                    <div class="holo-foil-layer"></div>
                    <div class="hologram-scanlines"></div>

                    <!-- Top Row Meta Registry Labels -->
                    <div class="meta-registry-row">
                        <span class="registry-serial"></span>
                        <div class="class-node">@LocalizationService.GetString(titan.Theme)</div>
                    </div>

                    <!-- Clean Full-Width Header Title -->
                    <div class="chassis-header">
                        <div class="title-container">
                            <h2 class="titan-display-title">@LocalizationService.GetString(titan.NameKey)</h2>
                        </div>
                    </div>

                    <!-- Centerpiece Immersive Image Window -->
                    <div class="artwork-glass-frame">
                        <div class="glass-reflection"></div>
                        <img src="/img/titans/cards/@titan.TypeBadge" class="chassis-art" alt="@titan.TypeBadge" />
                        <div class="laser-gold-trim"></div>
                    </div>

                    <!-- Spec Analytics Dashboard Grid -->
                    <div class="specs-dashboard-grid">
                        <div class="spec-node"></div>
                        <div class="spec-node align-right">
                            <div class="node-hdr">@LocalizationService.GetString(titan.HeightKey)</div>
                        </div>
                    </div>

                    <!-- Lore Paragraph Text Box -->
                    <div class="lore-summary-area">
                        <p class="lore-text-body">
                            @LocalizationService.GetString(titan.DescKey)
                        </p>
                    </div>

                    <div class="chassis-divider"></div>

                    <div class="hype-stats-container">
                        <div class="hype-stat-row">
                            <div class="hype-stat-header">
                                <span class="hype-stat-label">@LocalizationService.GetString("ParamPower")</span>
                                <span class="hype-stat-pct text-primary">@titan.Power%</span>
                            </div>
                            <progress class="progress progress-xs progress-primary w-full" value="@titan.Power" max="100"></progress>
                        </div>
                        <div class="hype-stat-row">
                            <div class="hype-stat-header">
                                <span class="hype-stat-label">@LocalizationService.GetString("ParamSpeed")</span>
                                <span class="hype-stat-pct text-accent">@titan.Speed%</span>
                            </div>
                            <progress class="progress progress-xs progress-accent w-full" value="@titan.Speed" max="100"></progress>
                        </div>
                        <div class="hype-stat-row">
                            <div class="hype-stat-header">
                                <span class="hype-stat-label">@LocalizationService.GetString("ParamArmor")</span>
                                <span class="hype-stat-pct text-warning">@titan.Armor%</span>
                            </div>
                            <progress class="progress progress-xs progress-warning w-full" value="@titan.Armor" max="100"></progress>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- 區域 3.5：漫畫分卷展示區 -->
<div class="flex flex-col gap-2">
    <h3 class="aot-section-title">
        <i class="ti ti-books"></i> @LocalizationService.GetString("MangaSectionTitle")
    </h3>
 
    <div class="manga-shelf-row-wrapper">
 
        <div class="manga-shelf-scroll manga-shelf-scroll--wrap">
            @foreach (var vol in _teaserVolumes)
            {
                var isOpen = _pulledVolumeNumber == vol.VolumeNumber;
                <div class="manga-spine @(isOpen ? "is-pulled" : "")"
                     @onclick="() => TogglePulledVolume(vol.VolumeNumber)">
                    <img src="/img/manga/volumes/@vol.CoverImage" class="manga-spine-cover" alt="Vol. @vol.VolumeNumber" />
                    <div class="manga-spine-number">@vol.VolumeNumber</div>

                    <div class="manga-spine-detail">
                        <div class="manga-detail-rating">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="ti @(i <= Math.Round(vol.DisplayRating) ? "ti-star-filled" : "ti-star")"></i>
                            }                            
                        </div>
                        <a href="/manga/@vol.VolumeNumber" class="aot-btn aot-btn--xsm aot-btn--red"
                            @onclick:stopPropagation="true">
                            @LocalizationService.GetString("Btn_ViewManga") <i class="ti ti-arrow-right"></i>
                        </a>
                    </div>
                </div>
            }
            <a href="/manga" class="manga-spine manga-spine--viewall">
                <span>@string.Format(LocalizationService.GetString("Btn_ViewAllManga"), 34)</span>
            </a>
        </div>
    </div>
</div>

<!-- 區域 4：兵團戰術裝備與牆外調查資產 -->
