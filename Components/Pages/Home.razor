@page "/{Lang}"
@inject AppLocalizationService LocalizationService
@using AOT.Services
@inject LanguageSwitchService LanguageSwitcher
@inject NavigationManager Nav
@implements IDisposable

<!-- 区域 1：顶部核心巨幕区 (互动式漫画分镜带) -->
<div class="manga-slider-container"
     @ontouchstart="HandleTouchStart"
     @ontouchend="HandleTouchEnd"
     @onmousemove="HandleMouseMove"
     @onmouseleave="HandleMouseLeave"
     style="--tilt-x: @(_tiltX)deg; --tilt-y: @(_tiltY)deg;"
     tabindex="0"
     aria-label="Manga Comic Panel Story Slider">

    <!-- Inner wrapper with hidden overflow to prevent slides from bleeding out, while letting arrows overflow -->
    <div style="position: absolute; inset: 0; overflow: hidden; border-radius: inherit;">
        <div class="manga-screentone-overlay"></div>

        @for (int i = 0; i < _mangaSlides.Count; i++)
        {
            var slide = _mangaSlides[i];
            var index = i;
            <div class="manga-slide @(index == _currentSlideIndex ? "active" : "")">
                <!-- Background Image -->
                <img src="/img/manga/@slide.Image" class="manga-bg-art" style="object-position: @slide.FocalPosition" alt="@LocalizationService.GetString(slide.TitleKey)" />
                <div class="manga-vignette"></div>

                <!-- Manga Speech Bubble / Combat Telemetry Panel -->
                <div class="manga-telemetry-panel">
                    <a href="@slide.MangaPath" class="aot-btn aot-btn--yellow" aria-label="Explore chapter details">
                        <i class="ti ti-bookmark mr-1"></i>@slide.Chapter
                    </a>
                    <h1 class="manga-panel-title">
                        @LocalizationService.GetString(slide.TitleKey)
                    </h1>

                    <!-- Manga Quote Display -->
                    <blockquote class="manga-quote-block">
                        “@LocalizationService.GetString(slide.QuoteKey)”
                    </blockquote>
 

                </div>
            </div>
        }
    </div>

    <!-- Manual Navigation Arrows -->
    <button class="manga-nav-arrow prev" @onclick="PrevSlide" aria-label="Previous Slide">
        <i class="ti ti-chevron-left"></i>
    </button>
    <button class="manga-nav-arrow next" @onclick="NextSlide" aria-label="Next Slide">
        <i class="ti ti-chevron-right"></i>
    </button>

    <!-- Navigation Dots -->
    <div class="manga-slider-dots">
        @for (int i = 0; i < _mangaSlides.Count; i++)
        {
            var index = i;
            <span class="manga-dot @(index == _currentSlideIndex ? "active" : "")"
                  @onclick="() => SetSlide(index)"></span>
        }
    </div>
</div>


