<script>
    var timelineDatabase = {
        e845: {
            m: { lbl: 'BREACHED', css: 'background-color: rgba(69,10,10,0.4); border: 1px solid rgba(127,29,29,0.5); color: #f87171;', text: 'Colossal Titan destroyed Shiganshina gate. Titans have flooded the interior. Humanity has abandoned the region.' },
            r: { lbl: 'SECURED', css: 'background-color: rgba(6,78,59,0.3); border: 1px solid rgba(16,185,129,0.3); color: #34d399;', text: 'Currently safe. Armed Garrison forces are actively reinforcing the barricades along the southern frontline districts.' },
            s: { lbl: 'SECURED', css: 'background-color: rgba(6,78,59,0.3); border: 1px solid rgba(16,185,129,0.3); color: #34d399;', text: 'The royal district remains untouched. Protected strictly by the Military Police Brigade to shield the true crown.' }
        },
        e850: {
            m: { lbl: 'FORFEIT', css: 'background-color: #1c1917; border: 1px solid #292524; color: #78716c;', text: 'Territory completely given up. Retaken attempts are strictly banned pending the Scout Survey expeditions.' },
            r: { lbl: 'CRITICAL', css: 'background-color: rgba(120,53,4,0.3); border: 1px solid rgba(217,119,6,0.3); color: #fbbf24;', text: 'Trost gate breached but plugged via Eren Yeager’s Titan form. Armor Titan threat detected nearby.' },
            s: { lbl: 'INFILTRATED', css: 'background-color: rgba(69,10,10,0.4); border: 1px solid rgba(127,29,29,0.5); color: #f87171;', text: 'Stohess District structurally damaged. Female Titan captured inside the walls after devastating urban combat.' }
        },
        e854: {
            m: { lbl: 'CRUMBLED', css: 'background-color: rgba(124,45,18,0.4); border: 1px solid rgba(194,65,12,0.4); color: #fb923c;', text: 'The hardening has completely dissolved. The ancient Wall Titans have woken up to begin their global march.' },
            r: { lbl: 'CRUMBLED', css: 'background-color: rgba(124,45,18,0.4); border: 1px solid rgba(194,65,12,0.4); color: #fb923c;', text: 'Wall shattered into debris as millions of massive Colossal giants walked straight out of the structures.' },
            s: { lbl: 'CRUMBLED', css: 'background-color: rgba(124,45,18,0.4); border: 1px solid rgba(194,65,12,0.4); color: #fb923c;', text: 'The absolute protective layout of the kingdom has dissolved. Complete chaos erupts across the royal capital.' }
        }
    };

    function changeAotEra(eraKey) {
        document.querySelectorAll('[id^="t-e"]').forEach(function(btn) {
            btn.style.backgroundColor = "transparent";
            btn.style.borderColor = "transparent";
            btn.style.color = "#78716c";
        });

        var active = document.getElementById('t-' + eraKey);
        active.style.backgroundColor = eraKey === 'e854' ? '#7c2d12' : '#450a0a';
        active.style.borderColor = eraKey === 'e854' ? '#ea580c' : '#7f1d1d';
        active.style.color = eraKey === 'e854' ? '#ffedd5' : '#f87171';

        var data = timelineDatabase[eraKey];
        setWallLayout('m', data.m);
        setWallLayout('r', data.r);
        setWallLayout('s', data.s);
    }

    function setWallLayout(id, target) {
        var b = document.getElementById(id + '-badge');
        b.style.cssText = 'margin: 20px 0; padding: 6px 16px; border-radius: 20px; font-size: 11px; font-weight: bold; display: inline-flex; align-items: center; gap: 6px; ' + target.css;
        b.innerHTML = '<span style="width: 6px; height: 6px; background-color: currentColor; border-radius: 50%;"></span>' + target.lbl;
        document.getElementById(id + '-desc').innerText = target.text;
    }
</script>


