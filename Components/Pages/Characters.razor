@page "/characters"
@page "/{Lang}/characters"
@using AOT.Services
@implements IDisposable
@inject AppLocalizationService LocalizationService
@inject LanguageSwitchService LanguageSwitcher

<PageTitle>@LocalizationService.NavCharacters - @LocalizationService.GetString("PageTitle")</PageTitle>

<div>
    <h3 class="aot-section-title mb-6">
        <i class="ti ti-swords"></i> @LocalizationService.NavCharacters
    </h3>

    <!-- faction jump-strip: same horizontal-scroll pattern as .manga-shelf-scroll -->
    <div class="manga-shelf-scroll" style="padding-top:0;">
        @foreach (var faction in CharacterData.FactionOrder)
        {
            @* if (!CharacterData.InFaction(faction).Any()) { continue; } *@
            @* Characters.razor *@
            <a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/characters#faction_@faction" class="aot-btn aot-btn--white aot-btn--sm" style="flex:0 0 auto;">
                @LocalizationService.GetString(CharacterData.FactionNameKeys[faction])
            </a>
        }
    </div>

    <div class="manga-continuous-grid">
        @foreach (var faction in CharacterData.FactionOrder)
        {
            var members = CharacterData.InFaction(faction).ToList();
            @* if (members.Count == 0) { continue; } *@

            <h4 id="faction_@faction" class="manga-arc-title" style="grid-column: 1 / -1;">
                @LocalizationService.GetString(CharacterData.FactionNameKeys[faction])
            </h4>

            @foreach (var member in members)
            {
                var isFeatured = faction == CharacterFaction.Main;
                <a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/characters/@member.Slug" class="character-game-card @(isFeatured ? "character-game-card--featured" : "") faction-@faction" data-holo-card aria-label="@LocalizationService.GetString(member.NameKey)">
                    <span class="character-game-card__glow"></span>
                    <span class="character-game-card__holo"></span>
                    <span class="character-game-card__glare"></span>
                    <span class="character-game-card__frame">
                        <span class="character-game-card__topline">
                            @if (!string.IsNullOrEmpty(member.Badge))
                            {
                                <span class="character-game-card__badge comic-badge @(member.Badge.StartsWith("S") ? "comic-badge--gold" : member.Badge.StartsWith("A") ? "comic-badge--silver" : "comic-badge--bronze")">@member.Badge</span>
                            }
                        </span>
                        <span class="character-game-card__portrait-wrap">
                            <img src="/img/characters/@member.Portrait" class="character-game-card__portrait"
                                 style="@(string.IsNullOrEmpty(member.FocalPosition) ? "" : $"object-position: {member.FocalPosition};")" alt="" />
                            @if (member.ExtraVersions is { Count: > 0 })
                            {
                                <span class="character-game-card__multiform" title="Multiple forms"><i class="ti ti-replace"></i></span>
                            }
                            <span class="character-game-card__scanlines"></span>
                            <span class="character-game-card__portrait-vignette"></span>
                        </span>
                        <span class="character-game-card__copy">
                            <span class="character-game-card__name">@TextFormatHelper.FormatNameWithAka(LocalizationService.GetString(member.NameKey))</span>                            <span class="character-game-card__title">@LocalizationService.GetString(member.TitleKey)</span>
                        </span>
                        <span class="character-game-card__logo-wrap">
                            <img src="/img/aot-logo-m.png" class="character-game-card__logo" alt="Attack on Titan" />
                        </span>
                    </span>
                </a>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string? Lang { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Lang))
            LanguageSwitcher.Initialize(Lang);
    }

    protected override void OnInitialized()
    {
        LanguageSwitcher.OnLanguageChanged += HandleLanguageChanged;
    }

    private void HandleLanguageChanged(string newLanguage) => StateHasChanged();

    public void Dispose()
    {
        LanguageSwitcher.OnLanguageChanged -= HandleLanguageChanged;
    }
}
