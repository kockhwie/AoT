@page "/manga"
@using AOT.Services

<PageTitle>Manga Volumes — Attack on Titan</PageTitle>

<h1 class="aot-section-title"><i class="ti ti-books"></i> All Manga Volumes</h1>

@foreach (var arc in MangaData.ArcOrder)
{
    var volsInArc = MangaData.VolumesInArc(arc).ToList();
    if (volsInArc.Count == 0) { continue; }

    <div class="manga-shelf-row-wrapper">
        <h4 class="manga-arc-title">@arc</h4>
        <div class="manga-shelf-scroll">
            @foreach (var vol in volsInArc)
            {
                <a href="/manga/@vol.VolumeNumber" class="manga-spine">
                    <img src="/img/manga/volumes/@vol.CoverImage" class="manga-spine-cover" alt="Vol. @vol.VolumeNumber" />
                    <div class="manga-spine-number">@vol.VolumeNumber</div>
                </a>
            }
        </div>
    </div>
}
