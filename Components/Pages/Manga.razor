@page "/manga"
@using AOT.Services
@implements IDisposable
@inject AppLocalizationService LocalizationService
@inject LanguageSwitchService LanguageSwitcher

<PageTitle>@LocalizationService.GetString("MangaAllVolumesTitle")  - @LocalizationService.GetString("PageTitle")</PageTitle>
<div class=" ">
    <h3 class="aot-section-title mb-6">
        <i class="ti ti-books"></i> @LocalizationService.GetString("MangaAllVolumesTitle")
        <span class="text-gray-400 text-lg ml-2 font-normal"> · @LocalizationService.GetString("MangaPageSubtitle")</span>
    </h3>

    <div class="manga-detail-layout">
        <!-- Sidebar Navigation to match detail page layout -->
        <aside class="manga-detail-sidebar">
            
            <div class="manga-detail-sidebar-meta w-full mt-4">
                <div class="manga-detail-sidebar-chapters mb-2 text-center md:text-left w-full border-b border-gray-800 pb-2">@LocalizationService.GetString("MangaStoryArcs")</div>
                <div class="flex flex-col gap-1 w-full text-center md:text-left">
                    @foreach (var arc in MangaData.ArcOrder)
                    {
                        var volsInArc = MangaData.VolumesInArc(arc).ToList();
                        if (volsInArc.Count > 0)
                        {
                            <div class="text-gray-400 hover:text-white transition-colors text-sm font-bold cursor-pointer">
                                <a href="/manga#section_@MangaData.ArcNameKeys[arc]">@LocalizationService.GetString(MangaData.ArcNameKeys[arc])</a>
                            </div>
                        }
                    }
                </div>
            </div>
        </aside>

        <!-- Main Content -->
        <main class="manga-detail-content">
            <div class="manga-continuous-grid">
                @foreach (var arc in MangaData.ArcOrder)
                {
                    var volsInArc = MangaData.VolumesInArc(arc).ToList();
                    if (volsInArc.Count == 0) { continue; }

                    <h4 id="section_@MangaData.ArcNameKeys[arc]" class="manga-arc-title" style="grid-column: 1 / -1;">
                        @LocalizationService.GetString(MangaData.ArcNameKeys[arc])
                        <!-- span  class="manga-arc-title-count">@volsInArc.Count VOL@(volsInArc.Count > 1 ? "S" : "")</span-->
                    </h4>
                    
                    @foreach (var vol in volsInArc)
                    {
                        <a href="/manga/@vol.VolumeNumber" class="manga-cover-card">
                            <div class="manga-cover-card-top-badge">VOL @vol.VolumeNumber</div>
                            <div class="manga-cover-card-img-wrap">
                                <img src="/img/manga/volumes/@vol.CoverImage"
                                     class="manga-cover-card-img"
                                     alt="Vol. @vol.VolumeNumber" />
                                <div class="manga-cover-card-shine"></div>
                            </div>
                        </a>
                    }
                }
            </div>
        </main>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        // Subscribe to language changes to trigger immediate UI update
        LanguageSwitcher.OnLanguageChanged += HandleLanguageChanged;
    }

    private void HandleLanguageChanged(string newLanguage)
    {
        // Trigger re-render when language changes
        StateHasChanged();
    }

    public void Dispose()
    {
        // Unsubscribe to prevent memory leaks
        LanguageSwitcher.OnLanguageChanged -= HandleLanguageChanged;
    }
}
