@using System.Globalization

<!DOCTYPE html>
@{
    // Capture the HttpContext directly from Blazor's cascading architecture
    var currentCulture = CultureInfo.CurrentUICulture.Name;
}
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>進撃の巨人 Attack on Titan @CultureInfo.CurrentUICulture.Name</title>

    <!-- SEO: Primary meta -->
    <meta name="description" content="The ultimate Attack on Titan encyclopedia — explore all 34 manga volumes, 9 titans, Survey Corps characters, gear, and the complete story arc timeline. Available in English, 繁體中文, and 日本語." />
    <meta name="keywords" content="Attack on Titan, 進撃の巨人, 進擊的巨人, AOT, SNK, manga, anime, titans, Survey Corps, Eren, Levi, Mikasa, Armin" />
    <meta name="author" content="aot.codingdinos.asia" />
    @inject NavigationManager Nav
    @{
        var absolutePath = new Uri(Nav.Uri).AbsolutePath;
        string neutralPath = absolutePath;
        string[] langs = { "zh", "en", "ja" };
        foreach (var l in langs)
        {
            var prefix = $"/{l}";
            if (absolutePath == prefix || absolutePath == prefix + "/")
            {
                neutralPath = "/";
                break;
            }
            if (absolutePath.StartsWith(prefix + "/"))
            {
                neutralPath = absolutePath.Substring(prefix.Length);
                break;
            }
        }
        string basePath = "https://aot.codingdinos.asia";
        string canonicalUrl = basePath + (neutralPath == "/" ? "/zh" : "/zh" + neutralPath); // Default canonical to zh
    }
    <link rel="canonical" href="@canonicalUrl" />
    <link rel="alternate" hreflang="zh" href="@(basePath)/zh@(neutralPath == "/" ? "" : neutralPath)" />
    <link rel="alternate" hreflang="en" href="@(basePath)/en@(neutralPath == "/" ? "" : neutralPath)" />
    <link rel="alternate" hreflang="ja" href="@(basePath)/ja@(neutralPath == "/" ? "" : neutralPath)" />
    <link rel="alternate" hreflang="x-default" href="@(basePath)/zh@(neutralPath == "/" ? "" : neutralPath)" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://googleapis.com">
    <link rel="preconnect" href="https://gstatic.com" crossorigin>
    <link href="https://googleapis.com/css2?family=Noto+Serif+TC:wght@700&display=swap" rel="stylesheet">

    <!-- SEO: Open Graph (Google, Facebook, Discord previews) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://aot.codingdinos.asia/" />
    <meta property="og:site_name" content="Attack on Titan Encyclopedia" />
    <meta property="og:title" content="進撃の巨人 — Attack on Titan Encyclopedia" />
    <meta property="og:description" content="The ultimate AOT reference — 34 manga volumes, 9 titans, Survey Corps roster, tactical gear, and story arc timeline. Multilingual: EN / 繁中 / 日本語." />
    <meta property="og:image" content="https://aot.codingdinos.asia/android-chrome-512x512.png" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta property="og:locale:alternate" content="ja_JP" />

    <!-- SEO: Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="進撃の巨人 — Attack on Titan Encyclopedia" />
    <meta name="twitter:description" content="The ultimate AOT reference — manga, titans, characters, gear, and timeline." />
    <meta name="twitter:image" content="https://aot.codingdinos.asia/android-chrome-512x512.png" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["AOT.styles.css"]" />

    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
    <link rel="manifest" href="site.webmanifest">

    <!-- daisyUI -->
    <!-- link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
    <link href="https://cdn.jsdelivr.net/npm/daisyui@5/themes.css" rel="stylesheet" type="text/css" / -->
    
  
 
    <link href="css/app.tailwind.css" rel="stylesheet" type="text/css" />

    <!-- Tabler Icons -->
    <!-- Updated path reflecting the new package distribution layout -->
    <link href="lib/tabler-icons/dist/tabler-icons.min.css" rel="stylesheet" />

 
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-BL311XYQLL"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());

        gtag('config', 'G-BL311XYQLL');
    </script>

    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="/js/character-cards.js"></script>
</body>

</html>
