@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject AppLocalizationService LocalizationService
@inject LanguageSwitchService LanguageSwitcher
@inject FactionPollService PollService
@inject IJSRuntime JS


<!-- Natively forces perfect font smoothing, line heights, and character tracking across devices -->
