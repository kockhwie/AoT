                            <a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/characters">@LocalizationService.NavCharacters</a>
                        </li> 
                        <li>
                            <details name="nav-menu-mobile">
                                <summary>@LocalizationService.NavExplore</summary>                     
                            <ul class="menu menu-sm dropdown-content z-50 mt-2 rounded-box nav-menu p-2 shadow-2xl">
                                    <li><a>@LocalizationService.GetString("Nav_Story")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Timeline")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Gallery")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Quotes")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Statistics")</a></li>
                                </ul>
                            </details>
                        </li>

                        <li><a>@LocalizationService.NavLoreMaps</a></li>

                        <li>
                            <details name="nav-menu-mobile">
                                <summary>@LocalizationService.NavMedia</summary>
                            <ul class="menu menu-sm dropdown-content z-50 mt-2 rounded-box nav-menu p-2 shadow-2xl">
                                    <li>
                                        <a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/about-author">@LocalizationService.GetString("Nav_AboutAuthorHajimeIsayama")</a>
                                    </li>
                                    <li><a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/manga">@LocalizationService.GetString("Nav_Manga")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Anime")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Games")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Comics")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Movies")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Fanarts")</a></li>
                                    <li><a>@LocalizationService.GetString("Nav_Other")</a></li>
                                </ul>
                            </details>
                        </li>

                        <li><a>@LocalizationService.NavNews</a></li>

                        <li><a>@LocalizationService.NavFanZone</a></li>
                    </ul>
                </div>
                <a class="text-sm" href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/"><img alt="進撃の巨人 Attack on Titan" src="/img/aot-logo-m.png" class="brand-mark" /></a>
            </div>
        <div class="navbar-center hidden lg:flex dropdown dropdown-open gap-8 ">
            <ul class="menu menu-horizontal gap-2 px-1 nav-links">
                    <li> 
                        <a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/characters">@LocalizationService.NavCharacters</a> 
                    </li>
                    <li>
                        <details name="nav-menu-desktop">
                            <summary tabindex="0">@LocalizationService.NavExplore</summary>
                            <ul tabindex="-1" class="menu menu-sm dropdown-content z-50 mt-2  nav-menu p-2 shadow-2xl">
                                <li><a>@LocalizationService.GetString("Nav_Story")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Timeline")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Gallery")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Quotes")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Statistics")</a></li>
                            </ul>
                        </details>
                    </li>
                    <li><a>@LocalizationService.NavLoreMaps</a></li>

                    <li>
                        <details name="nav-menu-desktop">
                            <summary tabindex="0">@LocalizationService.NavMedia</summary>
                            <ul tabindex="-1" class="menu menu-sm dropdown-content z-50 mt-2 nav-menu p-2 shadow-2xl">
                                <li>
                                    <a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/about-author">@LocalizationService.GetString("Nav_AboutAuthorHajimeIsayama")</a>
                                </li>
                                <li><a href="@(LanguageSwitchService.GetLangPrefix(LanguageSwitcher.ActiveLang))/manga">@LocalizationService.GetString("Nav_Manga")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Anime")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Games")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Comics")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Movies")</a></li>
                                <li><a>@LocalizationService.GetString("Nav_Fanarts")</a></li> 
                                <li><a>@LocalizationService.GetString("Nav_Other")</a></li>
                            </ul>
                        </details>
                    </li>

                    <li><a>@LocalizationService.NavNews</a></li>

                    <li><a>@LocalizationService.NavFanZone</a></li>
                </ul>
            </div>
            <div class="navbar-end">
                <!--1. Search -->
                <button class="btn btn-ghost btn-circle hidden md:inline-flex">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"> <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /> </svg>
                </button>

                <!-- 2. IMAGE LANGUAGE SWITCHER BUTTON SELECTION MATRIX -->
                <div class="flex gap-1.5 p-1 rounded-xl">
                    <button class="aot-btn aot-btn--lang @(_activeLang == "en" ? "is-active" : "")"
                            @onclick='() => ChangeLanguage("en")'>
                        EN
                    </button>
                    <button class="aot-btn aot-btn--lang @(_activeLang == "ja" ? "is-active" : "")"
                            @onclick='() => ChangeLanguage("jp")'>
                        JP
                    </button>
                    <button class="aot-btn aot-btn--lang @(_activeLang == "zh" ? "is-active" : "")"
                            @onclick='() => ChangeLanguage("zh")'>
                        CN
                    </button>
                </div>
            </div>
        </div>
        
        
 

    <!-- 3. MAIN CONTENT LAYOUT ENGINE -->
    <!-- 
      Responsive Rules Engine:
      - iPhone/Mobile: Arranges elements inside a singular column vertical feed channel.
      - Desktop/iPad Landscape: Automatically expands into a side-by-side split grid configuration.
    -->
    <div class="container mx-auto p-4 md:p-6 lg:p-8 flex-grow">
 
        <!-- CHILD ROUTE RENDERING INTERFACE LAYER -->
        <main class="flex flex-col gap-2">
            <CascadingValue Value="@_activeLang">
                @Body
            </CascadingValue>
        </main>

    </div>


    <!-- REVAMP FLOATING ACTION FACTION WIDGET -->
    <div class="faction-widget-container">
  
      <!-- The Floating Toggle Button (Always Visible) -->
        <button class="aot-btn aot-btn--limegreen" onclick="toggleFactionWidget()" aria-label="Toggle Faction Poll">
            <span class="faction-ping"></span>
            <i class="ti ti-chart-bar"></i>
            <span class="poll-btn-text">@LocalizationService.GetString("PollBtnText")</span>
        </button>

      <!-- The Popup Card Component -->
      <div class="faction-popup-card" id="factionPopup">
            <div class="popup-header">
              <h4 class="popup-title">@LocalizationService.GetString("PollTitle")</h4>
                <button class="popup-close-btn" onclick="toggleFactionWidget()"><i class="ti ti-x"></i></button>
            </div>
    
        
            <div class="popup-body">
                @if (!_hasVoted)
                {
                    <p class="popup-instruction">@LocalizationService.GetString("PollInstruction")</p>

                    <div class="faction-vs-badge">VS</div>

                    <div class="faction-voting-options">
                        <button class="vote-option-btn marley-btn" @onclick='() => Vote("marley")'>
                            <i class="ti ti-flag-2"></i> @LocalizationService.GetString("PollMarleyOpt")
                        </button>
                        <button class="vote-option-btn paradis-btn" @onclick='() => Vote("paradis")'>
                            <i class="ti ti-shield"></i> @LocalizationService.GetString("PollParadisOpt")
                        </button>
                    </div>
                }
                else
                {
                    <p class="popup-instruction">
                        @LocalizationService.GetString("PollThanks") <span class="comic-badge comic-badge--gold faction-voted-badge">@LocalizationService.GetString("PollVotedBadge")</span>
                    </p>

                    <div class="faction-results">
                        <div class="faction-result-row">
                            <div class="faction-result-label">
                                <span>@LocalizationService.GetString("PollMarleyOpt")</span>
                                <span>@MarleyPct% (@MarleyVotes)</span>
                            </div>
                            <div class="faction-result-track">
                                <div class="faction-result-fill marley" style="@MarleyFillStyle"></div>
                            </div>
                        </div>
                        <div class="faction-result-row">
                            <div class="faction-result-label">
                                <span>@LocalizationService.GetString("PollParadisOpt")</span>
                                <span>@ParadisPct% (@ParadisVotes)</span>
                            </div>
                            <div class="faction-result-track">
                                <div class="faction-result-fill paradis" style="@ParadisFillStyle"></div>
                            </div>
                        </div>
                    </div>

                    @if (!bolTurnOffReset)
                    {
                        <!-- Reset Vote Button for Testing -->
                        <div class="mt-3 text-center">
                            <button type="button" class="btn btn-xs btn-outline btn-warning" @onclick="ResetVote">
                                <i class="ti ti-refresh mr-1"></i> @LocalizationService.GetString("PollResetBtn")
                            </button>
                        </div>
                    }
                }
            </div>
      </div>
    </div>

        <!-- 4. SYSTEM FOOTER WRAPPER -->
    <footer class="footer footer-center p-6 bg-base-100 text-neutral-content text-xs border-t border-neutral">
        <aside class="flex flex-col gap-1.5">
            <p class="text-primary font-bold">@LocalizationService.FooterCredit</p>
        </aside>
    </footer>

</div>


<script>
    function toggleFactionWidget() {
        const popup = document.getElementById('factionPopup');
        if (popup) {
            popup.classList.toggle('is-active');
            }
    }

    // Close any details element when clicking outside of it
    document.addEventListener('click', (e) => {
        const details = document.querySelectorAll('details');
        details.forEach((detail) => {
            if (!detail.contains(e.target)) {
                detail.removeAttribute('open');
            }
        });
    });

    // Optional Close Security Action: Automatically minimizes open dropdown matrix if a user clicks outside bounds
    window.addEventListener('click', (e) => {
        const container = document.querySelector('.faction-widget-container');
        const popup = document.getElementById('factionPopup');
        if (popup && popup.classList.contains('is-active') && container && !container.contains(e.target)) {
            popup.classList.remove('is-active');
        }
    });
</script>


@code {
    private string _activeLang = "zh";
    private bool bolTurnOffReset = true; // Set to true to hide the reset button after testing

    private bool _showModal = false;
    private string _modalTitle = "";
    private string _modalBody = "";
    private string _modalBadge = "";
    private string _modalTheme = ""; // "error" (Marley) or "secondary" (Paradis)

    
    private bool _hasVoted;
    private string? _votedFaction;
    private Dictionary<string, long> _votes = new(StringComparer.OrdinalIgnoreCase);

    private long MarleyVotes => _votes.TryGetValue("marley", out var v) ? v : 0;
    private long ParadisVotes => _votes.TryGetValue("paradis", out var v) ? v : 0;
    private long TotalVotes => _votes.Values.Sum();

    private int MarleyPct => TotalVotes == 0 ? 50 : (int)Math.Round(MarleyVotes * 100.0 / TotalVotes);
    private int ParadisPct => TotalVotes == 0 ? 50 : 100 - MarleyPct;

    private string MarleyFillStyle => $"width: {MarleyPct}%;";
    private string ParadisFillStyle => $"width: {ParadisPct}%;";

    protected override void OnInitialized()
    {
        // Initialize the language switcher service
        LanguageSwitcher.Initialize(_activeLang);
        LocalizationService.ActiveLang = _activeLang;

        // Subscribe to language changes
        LanguageSwitcher.OnLanguageChanged += HandleLanguageChanged;
    }

    private void HandleLanguageChanged(string newLanguage)
    {
        _activeLang = newLanguage;
        LocalizationService.ActiveLang = newLanguage;
        StateHasChanged();
    }

    private void ChangeLanguage(string targetLang)
    {
        var currentUri = new Uri(Nav.Uri);
        var relativeUrl = currentUri.PathAndQuery;
        var targetUrl = LanguageSwitchService.GetLocalizedUrl(relativeUrl, targetLang);
        Nav.NavigateTo(targetUrl, forceLoad: false);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _votedFaction = await JS.InvokeAsync<string?>("localStorage.getItem", "aot_faction_vote");
            _hasVoted = !string.IsNullOrEmpty(_votedFaction);
            _votes = await PollService.GetAllVotesAsync();
            StateHasChanged();
        }
    }

    private async Task Vote(string faction)
    {
        if (_hasVoted) return;
        var newCount = await PollService.VoteAsync(faction);
        _votes[faction] = newCount;
        _votedFaction = faction;
        _hasVoted = true;
        await JS.InvokeVoidAsync("localStorage.setItem", "aot_faction_vote", faction);
        StateHasChanged();
    }

    private async Task ResetVote()
    {
        _hasVoted = false;
        _votedFaction = null;
        await JS.InvokeVoidAsync("localStorage.removeItem", "aot_faction_vote");
        _votes = await PollService.GetAllVotesAsync();
        StateHasChanged();
    }


}


<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
